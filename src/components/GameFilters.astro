---
import type { Category, Game, Publisher } from '../types/game';

/** Build-time data rendered by the catalog filter controls. */
interface Props {
    games: Game[];
    categories: Category[];
    publishers: Publisher[];
}

const { games, categories, publishers } = Astro.props;
---

<form
    class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5 shadow-lg"
    data-testid="game-filters"
    aria-label="Filter games"
>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <fieldset>
            <legend class="mb-3 text-base font-semibold text-slate-100">Categories</legend>
            <div class="flex flex-wrap gap-x-4 gap-y-3">
                {categories.map((category) => (
                    <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-200">
                        <input
                            class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                            type="checkbox"
                            name="category"
                            value={category.id}
                            data-testid={`category-filter-${category.id}`}
                        />
                        {category.name}
                    </label>
                ))}
            </div>
        </fieldset>

        <div class="flex flex-col gap-2 sm:flex-row sm:items-end">
            <label class="flex flex-col gap-2 text-sm font-semibold text-slate-100" for="publisher-filter">
                Publisher
                <select
                    id="publisher-filter"
                    name="publisher"
                    class="min-w-52 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid="publisher-filter"
                >
                    <option value="">All publishers</option>
                    {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
            </label>

            <button
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                type="reset"
                data-testid="clear-game-filters"
            >
                Clear filters
            </button>
        </div>
    </div>

    <p class="mt-4 text-sm text-slate-300" data-testid="filter-results-count" role="status" aria-live="polite">
        Showing {games.length} games.
    </p>
</form>

<script>
    const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
    const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-results-count"]');
    const gameCards = document.querySelectorAll<HTMLElement>('[data-testid="game-card"]');

    /** Update visible catalog cards and announce the current result count. */
    function applyFilters(): void {
        if (!filterForm || !resultCount) {
            return;
        }

        const selectedCategoryIds = new Set(
            Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked')).map(
                (input) => input.value,
            ),
        );
        const publisherId =
            filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]')?.value ?? '';

        let visibleCount = 0;

        gameCards.forEach((card) => {
            const categoryMatches =
                selectedCategoryIds.size === 0 || selectedCategoryIds.has(card.dataset.categoryId ?? '');
            const publisherMatches = publisherId === '' || publisherId === card.dataset.publisherId;
            const isVisible = categoryMatches && publisherMatches;

            card.hidden = !isVisible;
            if (isVisible) {
                visibleCount += 1;
            }
        });

        resultCount.textContent =
            visibleCount === 0
                ? 'No games match the selected filters.'
                : `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}.`;
    }

    if (filterForm) {
        filterForm.addEventListener('change', applyFilters);
        filterForm.addEventListener('reset', () => requestAnimationFrame(applyFilters));
    }
</script>
